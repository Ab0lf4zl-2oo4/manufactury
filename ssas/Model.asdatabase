      {
        "name": "dw dimw_o",
        "columns": [
          {
            "name": "work_order_id",
            "dataType": "int64",
            "sourceColumn": "work_order_id"
          },
          {
            "name": "asset_id",
            "dataType": "int64",
            "sourceColumn": "asset_id"
          },
          {
            "name": "order_type",
            "dataType": "string",
            "sourceColumn": "order_type"
          },
          {
            "name": "opened_at",
            "dataType": "string",
            "sourceColumn": "opened_at"
          },
          {
            "name": "closed_at",
            "dataType": "string",
            "sourceColumn": "closed_at"
          },
          {
            "name": "labor_hours",
            "dataType": "double",
            "sourceColumn": "labor_hours"
          },
          {
            "name": "parts_cost",
            "dataType": "double",
            "sourceColumn": "parts_cost"
          },
          {
            "name": "priority",
            "dataType": "string",
            "sourceColumn": "priority"
          },
          {
            "type": "calculated",
            "name": "cost time",
            "dataType": "double",
            "isDataTypeInferred": true,
            "expression": "('dw dimw_o'[closed_at]-'dw dimw_o'[opened_at])*'dw dimw_o'[labor_hours]"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"SQL/DESKTOP-JKUS70M;factory\",",
                "    dw_dimw_o = Source{[Schema=\"dw\",Item=\"dimw_o\"]}[Data]",
                "in",
                "    dw_dimw_o"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "total_wo",
            "expression": "COUNTROWS('dw dimw_o')"
          },
          {
            "name": "sum time",
            "expression": "sumx('dw dimw_o','dw dimw_o'[closed_at]-'dw dimw_o'[opened_at])"
          },
          {
            "name": "sum cost",
            "expression": "sum('dw dimw_o'[parts_cost])"
          },
          {
            "name": "avgtime",
            "expression": "DIVIDE([sum time],[total_wo])"
          },
          {
            "name": "avgcost",
            "expression": "DIVIDE([sum cost],[total_wo])"
          }
        ]
      },
